{
  "name": "skeleton",
  "adapter": "docker-compose",
  "compose_file": ".docker/compose.yml",
  "env_file": ".env",
  "http_port_env": "PORT_HTTP",
  "extra_port_envs": ["PORT_DB", "PORT_REDIS", "PORT_MAIL"],
  "preferred_ports": [8080, 3306, 6379, 8025],
  "compose_project_name": "devctl_skeleton",
  "env": {
    "PROJECT_NAME": "devctl_skeleton"
  },
  "build": false,
  "health_timeout_seconds": 120,
  "health_check_path": "/health",
  "health_check_statuses": [204],
  "extra_routes": [
    {"name": "mail", "port_env": "PORT_MAIL"}
  ],
  "primary_service": "gateway"
}
