{
  "name": "company/project-skeleton-legacy",
  "description": "Legacy PHP plus Vite preset for projects with a public web root.",
  "type": "project",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1.55",
    "phpunit/phpunit": "^12.5.27",
    "squizlabs/php_codesniffer": "^4.0.1"
  },
  "autoload": {
    "psr-4": {
      "LegacyApp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=256M",
    "lint": "phpcs",
    "format": "phpcbf",
    "format:check": "phpcs",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ]
  }
}
